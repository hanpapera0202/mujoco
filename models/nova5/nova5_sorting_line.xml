    <exclude body1="conveyor_collision_surface" body2="belt_segment_08"/>
    <!-- The two grippers may enter the shared handoff volume, but their
         hardware must not generate a mutual contact that aborts an otherwise
         valid pick.  These exclusions affect only A-versus-B gripper contact;
         finger pads still collide with parts and the conveyor. -->
    <exclude body1="A_gripper" body2="B_gripper"/>
    <exclude body1="A_left_finger" body2="B_left_finger"/>
    <exclude body1="A_left_finger" body2="B_right_finger"/>
    <exclude body1="A_right_finger" body2="B_left_finger"/>
    <exclude body1="A_right_finger" body2="B_right_finger"/>
    <!-- A station plate is the mounting surface of its own arm; it is not a
         moving obstacle for that arm's links. -->
    <exclude body1="robot_A_base" body2="A_Link1"/>
    <exclude body1="robot_A_base" body2="A_Link2"/>
    <exclude body1="robot_A_base" body2="A_Link3"/>
