<mujoco model="falling_box">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.3 0.3 0.3"
               diffuse="0.7 0.7 0.7"
               specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture name="skybox" type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture name="floor_texture" type="2d" builtin="checker"
             rgb1="0.20 0.30 0.40" rgb2="0.10 0.20 0.30"
             width="512" height="512"/>
    <material name="floor_material" texture="floor_texture"
              texrepeat="8 8" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0 0 4" dir="0 0 -1" directional="true"/>

    <geom name="floor" type="plane" size="5 5 0.1"
          material="floor_material" friction="1 0.005 0.0001"/>

    <body name="box" pos="0 0 1.5">
      <freejoint name="box_freejoint"/>
      <geom name="box_geom" type="box" size="0.2 0.2 0.2"
            mass="1" rgba="0.8 0.1 0.1 1"/>
    </body>
  </worldbody>
</mujoco>
